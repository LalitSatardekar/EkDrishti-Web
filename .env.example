# Backend configuration: copy to .env only on a new setup. Keep existing credentials.
# Blog revision transactions require Atlas or a local MongoDB replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/ekdrishti?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-private-secret
BOOTSTRAP_ADMIN=false

# Backend and Vite must agree on the canonical Blog host.
BLOG_PUBLIC_ORIGIN=https://www.ekdrishti.com
VITE_BLOG_PUBLIC_ORIGIN=https://www.ekdrishti.com

# Existing SMTP/S3 configuration is documented in README.md. Production DB checks
# also require SMTP_HOST and SMTP_PASSWORD. Use actual provider values privately.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# Optional real Search Console metrics. Keep these server-side.
# SEARCH_CONSOLE_SITE_URL=https://www.ekdrishti.com/
# SEARCH_CONSOLE_ACCESS_TOKEN=

# Optional IndexNow outbox worker; never use VITE_ for these secrets.
# INDEXNOW_KEY=
# BLOG_WORKER_SECRET=
