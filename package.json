{
  "name": "premium-digital-agency",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fullstack": "vercel dev",
    "build": "vite build",
    "preview": "vite preview",
    "assets:compress": "node scripts/compress-assets.mjs",
    "assets:webp": "node scripts/compress-webp.mjs",
    "assets:webp:force": "node scripts/compress-webp.mjs --force",
    "db:backup": "node --env-file=.env scripts/db-backup-json.js",
    "db:migrate": "node --env-file=.env scripts/backup-and-migrate-to-atlas.js",
    "audit": "node --env-file=.env scripts/audit-production-readiness.mjs",
    "api": "node --env-file=.env server.js",
    "api:dev": "node --watch --env-file=.env server.js",
    "start": "node server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.3.3",
    "express": "^5.2.1",
    "framer-motion": "^11.3.0",
    "gsap": "^3.14.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "sharp": "^0.33.3",
    "tailwindcss": "^3.4.6",
    "vercel": "^50.42.0",
    "vite": "^7.3.1"
  }
