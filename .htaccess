Options -MultiViews
RewriteEngine On

# If a static file exists in public/ or dist/, serve it
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# For all other requests (including /api/*, /health, and client routes), route to server
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]