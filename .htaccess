PassengerAppRoot "/home/u374186957/domains/ekdrishti.com/public_html"
PassengerAppType node
PassengerStartupFile server.js

Options -MultiViews
RewriteEngine On

# 1. Bypass rewrite for API and Health requests so Node/Passenger handles them
RewriteCond %{REQUEST_URI} ^/api/ [OR]
RewriteCond %{REQUEST_URI} ^/health
RewriteRule ^ - [L]

# 2. Direct static assets
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 3. SPA Fallback for client-side pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [QSA,L]

