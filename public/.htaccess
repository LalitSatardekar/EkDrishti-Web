DirectoryIndex dist/index.html index.html index.php
Options -Indexes +FollowSymLinks
RewriteEngine On

# 1. Serve existing static files in public_html, dist/, or public/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Route root request directly to dist/index.html
RewriteRule ^$ dist/index.html [L]

# 3. SPA Fallback for all other routes to dist/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ dist/index.html [L]
